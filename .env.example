# World of Zuul — 环境变量模板
# 复制此文件为 .env 并填入实际值

# MySQL
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword
MYSQL_USER=zuul
MYSQL_PASSWORD=ChangeThisPassword
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeThisRedisPassword

# Application
APP_PORT=8080
JWT_SECRET=ChangeThisToRandomSecretKey2026
JWT_EXPIRATION=86400000

# Spring Profiles (dev / prod)
SPRING_PROFILES_ACTIVE=dev
